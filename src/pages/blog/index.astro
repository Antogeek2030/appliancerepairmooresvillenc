---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = [
  {
    slug: "signs-your-refrigerator-needs-repair",
    title: "5 Signs Your Refrigerator Needs Professional Attention",
    description: "Learn common warning signs that a refrigerator may need repair before food spoilage becomes a bigger problem.",
    pubDate: "2026-09-15",
  },
  {
    slug: "washer-not-draining-common-causes",
    title: "Washer Not Draining? Common Causes and What to Check First",
    description: "A practical look at why washing machines stop draining and simple checks you can try before scheduling a repair visit.",
    pubDate: "2026-10-02",
  },
];
---

<BaseLayout
  title="Blog | Appliance Repair Tips for Mooresville NC"
  description="Practical appliance care and troubleshooting tips from a local Mooresville, NC repair team. Refrigerators, washers, dryers, and more."
>
  <section class="bg-primary-700 text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">Appliance Tips & Guides</h1>
      <p class="text-lg text-primary-100 max-w-2xl">
        Straightforward advice to help you understand common appliance issues and when to call for service.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="border-b border-gray-200 pb-8 last:border-0">
            <time class="text-sm text-gray-500" datetime={post.pubDate}>
              {new Date(post.pubDate).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </time>
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mt-2 mb-3">
              <a href={`/blog/${post.slug}/`} class="hover:text-primary-700 transition-colors">{post.title}</a>
            </h2>
            <p class="text-gray-600 leading-relaxed mb-3">{post.description}</p>
            <a href={`/blog/${post.slug}/`} class="text-primary-600 font-medium hover:underline">Read more →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
