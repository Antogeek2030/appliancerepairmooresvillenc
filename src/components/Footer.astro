---
import { siteConfig, services, areas, navLinks } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 rounded-lg bg-primary-600 flex items-center justify-center text-white font-bold">AR</div>
          <div>
            <span class="block text-white font-bold">Appliance Repair</span>
            <span class="block text-sm text-primary-400">Mooresville NC</span>
          </div>
        </div>
        <p class="text-sm leading-relaxed mb-4">
          Friendly, professional appliance repair for homes and businesses in Mooresville and the surrounding Lake Norman area.
        </p>
        <a href={`tel:${siteConfig.phone}`} class="inline-flex items-center gap-2 text-white font-semibold hover:text-primary-400 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {siteConfig.phoneDisplay}
        </a>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold mb-4">Services</h3>
        <ul class="space-y-2 text-sm">
          {services.slice(0, 8).map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} class="hover:text-primary-400 transition-colors">{s.name}</a>
            </li>
          ))}
          <li>
            <a href="/services/" class="text-primary-400 hover:text-primary-300 font-medium">All services →</a>
          </li>
        </ul>
      </div>

      <!-- Areas -->
      <div>
        <h3 class="text-white font-semibold mb-4">Service Areas</h3>
        <ul class="space-y-2 text-sm">
          {areas.map((a) => (
            <li>
              <a href={`/areas/${a.slug}/`} class="hover:text-primary-400 transition-colors">{a.name}</a>
            </li>
          ))}
          <li>
            <a href="/service-areas/" class="text-primary-400 hover:text-primary-300 font-medium">View all areas →</a>
          </li>
        </ul>
      </div>

      <!-- Contact & Links -->
      <div>
        <h3 class="text-white font-semibold mb-4">Contact</h3>
        <address class="not-italic text-sm space-y-2 mb-6">
          <p>{siteConfig.address.street}</p>
          <p>{siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}</p>
          <p>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-primary-400 transition-colors">{siteConfig.email}</a>
          </p>
        </address>
        <ul class="space-y-2 text-sm">
          <li><a href="/about/" class="hover:text-primary-400 transition-colors">About Us</a></li>
          <li><a href="/blog/" class="hover:text-primary-400 transition-colors">Blog</a></li>
          <li><a href="/contact/" class="hover:text-primary-400 transition-colors">Contact</a></li>
          <li><a href="/privacy-policy/" class="hover:text-primary-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-primary-400 transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm">
      <p>&copy; {year} Appliance Repair Mooresville NC. All rights reserved.</p>
      <p class="text-gray-500">Serving Mooresville, Lake Norman & surrounding communities.</p>
    </div>
  </div>
</footer>
