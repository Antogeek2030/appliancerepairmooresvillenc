---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig, services } from "../../data/site";
---

<BaseLayout
  title="Appliance Repair Services in Mooresville NC"
  description="Browse our full list of appliance repair services in Mooresville, NC — refrigerators, washers, dryers, dishwashers, ovens, and more. Call (844) 605-0165."
>
  <section class="bg-primary-700 text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">Appliance Repair Services</h1>
      <p class="text-lg text-primary-100 max-w-2xl">
        Professional diagnostics and repairs for the appliances you use every day. Select a service below to learn more or call us to schedule.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <a
            href={`/services/${service.slug}/`}
            class="group block p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-md transition-all"
          >
            <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-700 mb-2">{service.name}</h2>
            <p class="text-sm text-gray-600 leading-relaxed mb-3">{service.shortDesc}</p>
            <span class="text-sm font-medium text-primary-600 group-hover:underline">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Not sure which service you need?</h2>
      <p class="text-gray-600 mb-6">Describe the problem and we'll point you in the right direction.</p>
      <a href={`tel:${siteConfig.phone}`} class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700">
        Call {siteConfig.phoneDisplay}
      </a>
    </div>
  </section>
</BaseLayout>
